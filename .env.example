# ============================================
# NFT Public Mint — optional configuration
# ============================================
# Everything here is OPTIONAL. The wizard asks for what it needs and these
# values just become the pre-filled defaults.
#
# Copy to .env:   cp .env.example .env
#
# NEVER put private keys in this file. Keys are pasted into the CLI at run
# time, held in memory only, and never written to disk.

# --- RPC endpoints (recommended) ---
# A private RPC is the single biggest factor in whether you win a contested
# mint. Public nodes work but are slower and rate-limited.
# One entry per chain you mint on. You can also paste these at the prompt.
RPC_URL_ETHEREUM=
RPC_URL_BASE=
RPC_URL_ROBINHOOD=

# --- Default chain highlighted in the menu ---
# ethereum | base | robinhood
CHAIN=base

# --- Gas defaults (gwei) ---
# Pre-filled at the prompt; you confirm or change them on every run.
# The max fee is a CEILING, not what you pay — you pay base fee + tip. But note
# a node reserves gasLimit × maxFee upfront, so the wallet must hold that much.
MAX_FEE_PER_GAS=2
MAX_PRIORITY_FEE=0.05

# Gas limit per mint tx. A SeaDrop mint uses roughly 135k for quantity 1.
GAS_LIMIT=250000

# --- OpenSea REST API key (optional) ---
# ONLY used to turn a collection slug into a contract address, and the tool tries
# that lookup with or without a key — OpenSea often answers unauthenticated. A
# key just makes it reliable. Pasting the 0x contract address always works and
# needs nothing here. The mint itself never contacts OpenSea.
# Free key: https://docs.opensea.io/reference/api-keys
OPENSEA_API_KEY=

# --- Autonomous free-mint watcher (npm start -- --auto) ---
# Watches the shared SeaDrop contract's on-chain events for any collection's
# public stage going live at mintPrice = 0, and mints the max per wallet the
# instant it's live — no confirmation prompt. Real transactions, real gas,
# no human in the loop. OPENSEA_API_KEY above is used only to label sightings
# in the log; discovery itself never depends on OpenSea.
#
# SECURITY: unlike the wizard (which never writes a key to disk), this mode
# has no prompt to paste one into, so AUTO_WALLET_KEYS must live here. Use a
# dedicated wallet with only what you're willing to lose — every free "mint"
# still costs real gas, and this fires on every match with no review.
AUTO_WALLET_KEYS=
AUTO_CHAIN=base
AUTO_POLL_MS=4000

# Optional caps — leave blank for "no limit" (true max-per-wallet, unbounded run).
AUTO_MAX_QUANTITY=
AUTO_MAX_MINTS_PER_RUN=

# eth_getLogs block range per call. Defaults to 10, which is deliberately
# conservative — it's Alchemy's FREE TIER limit, and a too-large value doesn't
# degrade gracefully, it just errors on every scan and the watcher goes blind
# silently. If you're on a paid RPC plan (or a public node with a generous
# limit) you can raise this for faster catch-up after downtime — it has no
# effect on steady-state polling, which only ever needs a couple of blocks.
AUTO_LOG_CHUNK_BLOCKS=10
